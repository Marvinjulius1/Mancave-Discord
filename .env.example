# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# Die .env NIEMALS committen oder teilen!
DISCORD_TOKEN=dein-bot-token-hier
GUILD_ID=123456789012345678

# Optional: KI-Coach (/coach) – Key von https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Web-Dashboard
# Ohne Passwort nur lokal erreichbar (http://127.0.0.1:8080)
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=

# Optional: Speicherort der Datenbank (Standard: data/mancave.db)
# DB_PATH=/pfad/zu/mancave.db
